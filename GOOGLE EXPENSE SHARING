import sqlite3

DB_NAME = "expenses.db"

def connect():
    return sqlite3.connect(DB_NAME)

def init_db():
    conn = connect()
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS expenses (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT,
            amount REAL
        )
    ''')
    conn.commit()
    conn.close()

def add_expense(name, amount):
    conn = connect()
    cursor = conn.cursor()
    cursor.execute("INSERT INTO expenses (name, amount) VALUES (?, ?)", (name, amount))
    conn.commit()
    conn.close()

def get_expenses():
    conn = connect()
    cursor = conn.cursor()
    cursor.execute("SELECT name, amount FROM expenses")
    data = cursor.fetchall()
    conn.close()
    return [{"name": row[0], "amount": row[1]} for row in data]

def calculate_balances():
    expenses = get_expenses()
    balances = {}
    
    for exp in expenses:
        balances[exp["name"]] = balances.get(exp["name"], 0) + exp["amount"]

    return balances
